@article{ryazanovaBiascorrectedMonthlyPrecipitation2021,
  title = {Bias-Corrected Monthly Precipitation Data over {{South Siberia}} for 1979-2019},
  author = {Ryazanova, Anna and Voropay, Nadezhda and Dyukarev, Egor},
  year = 2021,
